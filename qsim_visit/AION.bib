  urldate = {2026-06-11},
  abstract = {This Technical Design Report presents AION-10, a 10-meter atom interferometer to be located at Oxford University using ultracold strontium atoms to make precision measurements of fundamental physics. AION10 serves as both a prototype for future larger-scale experiments and a versatile scientific instrument capable of conducting its own diverse physics programme.},
