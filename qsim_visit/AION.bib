@misc{arduiniTechnicalProposalAtom2026,
  title = {Technical {{Proposal}} for the {{Atom Interferometer CERN Experiment}} ({{AICE}}) {{Facility}}},
  author = {Arduini, Gianluigi and Augst, Nadja and Bason, Mark G. and Baynham, Charles and Bertoldi, Andrea and Bertone, Gianfranco and Blas, Diego and Bortoletto, Daniela and Bose, Sougato and Bozzi, Roberto Ales and Buchmueller, Oliver and Bud, Tamara Alice and Burrage, Clare and Calatroni, Sergio and Carlton, John and Charmandaris, Vassilis and Chiofalo, Maria Luisa and Clad{\'e}, Pierre and Coleman, Jonathon and Corsanego, Fabio and Roeck, Albert De and Devienne, Arnaud and Pumpo, Fabio Di and Ellis, John and Fayet, Pierre and Foot, Chris and Fuchs, Elina and Gaaloul, Naceur and Gardner, Susan and Giese, Enno and Granados, Eduardo and {Guellati-Khelifa}, Sa{\"i}da and Guinchard, Michael and Hakulinen, Timo and Harte, Tiffany and Hobson, Richard and Holynski, Michael and Infantino, Angelo and Kehagias, Alex and {Kilian-Rademacher}, Eva and Korsch, Wolfgang and Lafarge, Damien and Lellouch, Samuel and Lombriser, Lucas and Asamar, Elias Lopez and {Lopez-Gonzalez}, J. Luis and Maggiore, Michele and Marcel, Charline and Marchant, Anna and McCabe, Christopher and Mileti, Gaetano and Millington, Peter and Mitchell, Jeremiah and Mouelle, Noam and Cornago, Angel Navascues and Pillon, Fran{\c c}ois and Poggiani, Rosa and Rafelski, Johann and Rasel, Ernst M. and Reckermann, Maike and Roura, Albert and Samoes, Rui and Nieto, Federico Sanchez and Sander, Jack and Scarcia, Carlo and Schelfhout, Jesse and Schleich, Wolfgang and Schlippert, Dennis and Schneider, Ulrich and Schramm, Steven and Schreck, Florian and Sergijenko, Olga and {Soares-Santos}, Marcelle and Tino, Guglielmo M. and Tinsley, Jonathan N. and Valenzuela, Tristan and Valuch, Daniel and van der Grinten, Maurits and van Druten, Klaasjan and Vaskonen, Ville and von Klitzing, Wolf and Werner, Michael},
  year = 2026,
  month = aug,
  number = {arXiv:2608.18743},
  eprint = {2608.18743},
  primaryclass = {hep-ex},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2608.18743},
  urldate = {2026-09-26},
  abstract = {We present the technical proposal for the Atom Interferometer CERN Experiment (AICE), a \$\textbackslash mathcal\textbraceleft O\textbraceright (100)\$ m vertical atom interferometer to be installed against the wall of the PX46 access shaft to the LHC. AICE is conceived as a versatile and flexible long-baseline atom-interferometry facility whose primary scientific goal is probing for bosonic ultralight dark matter (ULDM) in a mass range inaccessible to other experiments, with a secondary goal of pioneering the exploration of gravitational waves (GWs) with frequencies in the range \$\textbraceleft\textbackslash sim\textbraceright\$0.03-3 Hz as a pathfinder for future longer-baseline detectors. The initial configuration employs ultracold \$\textasciicircum\textbraceleft 87\textbraceright\$Sr atoms in a single-photon 698-nm interferometer with three shaft-based atom sources in a multi-source gradiometer geometry, supported by one surface reference source for laser stabilisation and diagnostics, to target scalar ULDM. Operation with \$\textasciicircum\textbraceleft 88\textbraceright\$Sr will give sensitivity to axion-like particles (ALPs), vector ULDM with \$B-L\$ couplings and violation of the principle of equivalence, while a \$\textasciicircum\textbraceleft 171\textbraceright\$Yb upgrade will improve the sensitivity to \$B-L\$ couplings and equivalence violations. Probing the Einstein equivalence principle (EP) and measuring \${$\alpha\$$} will proceed in parallel with the ULDM searches. A conceptual feasibility study and a detailed technical implementation study have established that PX46 is a uniquely mature and implementation-ready site, with no technical showstoppers. Completing site preparation works during LS3 would enable the subsequent installation and operation of AICE without impacting HL-LHC operations. The detector design builds on the VLBAI and MAGIS experiments and the AION-10 Technical Design Report, scaling the strontium gradiometer architecture to the \$\textbackslash sim\$100 m baseline. AICE is endorsed by the TVLBAI Proto-Collaboration, comprising 57 institutions in 22 countries.},
  archiveprefix = {arXiv},
  keywords = {Astrophysics - Instrumentation and Methods for Astrophysics,General Relativity and Quantum Cosmology,High Energy Physics - Experiment,Physics - Atomic Physics,Physics - Instrumentation and Detectors,Quantum Physics}
}

