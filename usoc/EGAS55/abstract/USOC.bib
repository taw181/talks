	pages = {023331},
	file = {APS Snapshot:/home/twalker/Zotero/storage/5R8SGNUS/PhysRevA.103.html:text/html;Full Text PDF:/home/twalker/Zotero/storage/TGKXF293/Akatsuka et al. - 2021 - Three-stage laser cooling of Sr atoms using the \$5.pdf:application/pdf},
}
