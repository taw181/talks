%% CUSTOM COMMANDS %%
\newcommand{\picpos}[5][]{
  \begin{textblock*}{#2}(#3, #4)
    \textblockcolor{#1}
    \includegraphics[width=\textwidth]{#5}
  \end{textblock*}
}

\newcommand{\svgpos}[5]{
  \begin{textblock*}{#1}(#2, #3)
      \includesvg[width=\textwidth, #4]{#5}
  \end{textblock*}
}

\newcommand{\Ba}{\ensuremath{^{\text{138}}\text{Ba}^{\text +}}}
\newcommand{\Li}{\ensuremath{^{\text 6}\text{Li}}}
\newcommand{\ba}{\ensuremath{\text{Ba}^{\text +}}}
\newcommand{\li}{\ensuremath{\text{Li}}}
