\begin{frame}[t]{The Atom Trap}
  %\begin{textblock*}{0.4\linewidth}(0.1cm,0.1cm)
  \only<1>{  Atomic beam cooled with Zeeman slower.

  Initially loaded into a MOT of $\sim 10^6$ atoms.
    %\end{textblock*}
    \picpos{.55\linewidth}{0.0\linewidth}{.5cm}{mot_lasers.png}
    \picpos{.35\linewidth}{0.6\linewidth}{1cm}{mot.png}
      }
 \only<2>{
 \begin{itemize}
  \item Atoms transferred from MOT to crossed optical dipole trap (xODT)

  \item Evaporatively cooled to $T\approx\SI{1}{\micro\kelvin}$

  \item Spin polarised

  \item $\sim \SI{e4}{}$ $^6$Li atoms. Peak density $\sim \SI{e13}{\per\cm\cubed}$.
 \end{itemize}
  %\end{textblock*}
    \picpos{.6\linewidth}{0.0\linewidth}{0.9cm}{xodt_schematic.png}
    \picpos{.4\linewidth}{0.6\linewidth}{0.4cm}{xodt_sim.png}
    }
\end{frame}

\begin{frame}[t]{The Ion Trap}
    \begin{textblock*}{0.4\linewidth}(0.0\linewidth,0.0\linewidth)
      % \only<1-2>{
      % Design considerations:
      % \begin{itemize}
      %   \item Single ion or strings
      %   \item Optical access
      %   \item Stray field (micromotion) compensation
      % \end{itemize}
      % }
      \only<1-2>{
      Trap parameters:
      \begin{itemize}
        \item $\omega_{\textrm{rad}} \approx 2\pi\times\SI{100}{\kilo\hertz}$
        \item $\omega_{\textrm{ax}} \approx 2\pi\times\SI{10}{\kilo\hertz}$
        \item $\Omega_{\textrm{rf}} \approx \SI{1.4}{\mega\hertz}$
      \end{itemize}
      }
    \end{textblock*}
% \visible<1-2>{\picpos{.55\linewidth}{0cm}{.8cm}{paulfalle_xy.pdf}}
\only<1-2>{\picpos{.5\linewidth}{.5\linewidth}{.45cm}{IonTrap_3_free.png}}
\only<3>{\picpos{.5\linewidth}{.5\linewidth}{1cm}{trap_side.png}}
\only<3>{\picpos{.5\linewidth}{0\linewidth}{0.45cm}{trap_axis.png}}
\only<4>{
\begin{textblock*}{0.4\linewidth}(0.0\linewidth,0.0\linewidth)
\begin{itemize}
  \item Loaded through ablation loading and photoionisation
  \item Doppler cooled to near Doppler limit ($T_{\textrm{D}}=\SI{365}{\micro\kelvin}$)
  \item Prepared in ground state spin-mixture
  \item Detected via fluorescence on CCD
  \item $\approx\SI{1}{\micro\meter}$ position resolution
  \item Stray fields compensated to \SI{3}{\milli\volt\per\meter}
\end{itemize}
\end{textblock*}
\picpos{.5\linewidth}{.5\linewidth}{.45cm}{IonTrap_3_free.png}
}
